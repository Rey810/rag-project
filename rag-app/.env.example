# Copy to rag-app/.env for local dev. In production these are set in the host's env (Railway).
OPENAI_API_KEY=            # embeddings (text-embedding-3-small)
ANTHROPIC_API_KEY=         # chat, query rewrite, fact-sheet descriptions (claude-sonnet-5)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=       # e.g. allanclear-dense (1536 dims, cosine)
APP_ACCESS_CODE=           # shared access code; the server refuses to start without it
ARIZE_SPACE_ID=            # optional: observability
ARIZE_API_KEY=             # optional: observability
# STATIC_DIR=              # optional: path to the built frontend; defaults to ../rag-client/dist
